# =============================================================================
# Computer Vision & Real-Time Person Analytics System
# Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment.
# NEVER commit the .env file to version control.

# --- Application ---
APP_ENV=development
DEBUG=false
APP_NAME=CV Person Analytics
APP_VERSION=1.0.0
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# --- Database ---
DATABASE_URL=postgresql+asyncpg://cvuser:cvpassword@postgres:5432/cv_analytics
DATABASE_SYNC_URL=postgresql://cvuser:cvpassword@postgres:5432/cv_analytics

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=cvuser
POSTGRES_PASSWORD=cvpassword
POSTGRES_DB=cv_analytics

# --- Face Recognition ---
FACE_MATCH_THRESHOLD=0.55
FACE_MODEL_NAME=buffalo_l
FACE_EMBEDDING_DIMENSION=512
FACE_MIN_QUALITY_SCORE=0.5
FACE_MIN_SIZE=80

# --- Eye State Analysis ---
EYE_CLOSED_THRESHOLD=0.20
EYE_DROWSY_DURATION_SECONDS=1.5
EYE_SLEEP_DURATION_SECONDS=3.0
EYE_SMOOTHING_WINDOW=5

# --- Expression Analysis ---
EXPRESSION_CONFIDENCE_THRESHOLD=0.4
EXPRESSION_SMOOTHING_WINDOW=5

# --- Detection Pipeline ---
DETECTION_FPS=15
FACE_RECOGNITION_INTERVAL=5
HAND_DETECTION_INTERVAL=2
EXPRESSION_DETECTION_INTERVAL=3
MAX_PERSONS=10
CAMERA_SOURCE=0

# --- Detection Event Storage ---
EVENT_BATCH_INTERVAL_SECONDS=30
EVENT_RETENTION_DAYS=30

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
MIN_IMAGE_DIMENSION=100
MAX_IMAGE_DIMENSION=4096

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Privacy ---
RETAIN_ORIGINAL_IMAGES=true
FACE_IMAGE_RETENTION_DAYS=365
AUTO_DELETE_INACTIVE_PERSONS_DAYS=0
